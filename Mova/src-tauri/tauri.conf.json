{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mova",
  "version": "0.1.1",
  "identifier": "com.mova.app",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mova",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false,
        "decorations": true
      }
    ],
	    "security": {
	      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https:; img-src 'self' asset: http://asset.localhost http://localhost:* data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
	      "assetProtocol": {
	        "enable": true,
	        "scope": ["$HOME/**", "$TEMP/**"]
	      }
	    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
