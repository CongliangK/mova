{
  "name": "mova",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "22.23.3",
    "pnpm": "11.28.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:release": "node --test scripts/release-contract.test.mjs",
    "test:report": "node scripts/report-test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:release && pnpm test && pnpm build",
    "verify:full": "pnpm verify && pnpm test:rust",
    "verify:report": "node scripts/verify-report.mjs",
    "qa:gate": "node scripts/qa-gate.mjs",
    "perf": "pnpm perf:baseline",
    "perf:baseline": "cross-env MOVA_WRITE_PERF_BASELINE=1 vitest run src/__tests__/perf/performance-baseline.test.ts",
    "preview": "vite preview",
    "install:local": "node scripts/install-local.mjs",
    "update:local": "node scripts/install-local.mjs",
    "tauri": "cross-env GDK_SCALE=1 tauri",
    "tauri:fast": "cross-env GDK_SCALE=1 MOVA_ENABLE_LINUX_DMABUF=1 tauri",
    "tauri:compat": "cross-env GDK_SCALE=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri",
    "tauri:build:linux": "node scripts/build-linux.mjs",
    "tauri:dev:linux-fast": "cross-env GDK_SCALE=1 MOVA_ENABLE_LINUX_DMABUF=1 pnpm tauri dev",
    "tauri:dev:linux-compat": "cross-env GDK_SCALE=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 pnpm tauri dev",
    "tauri:dev:linux-x11": "cross-env GDK_SCALE=1 GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 pnpm tauri dev",
    "tauri:dev:linux-force-compositing": "sh -c 'unset WEBKIT_DISABLE_COMPOSITING_MODE MOVA_ENABLE_LINUX_DMABUF; export GDK_SCALE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1; pnpm tauri dev'",
    "tauri:dev:x11-cpu": "cross-env GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 pnpm tauri dev"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.79.1",
    "@earendil-works/pi-ai": "0.79.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2",
    "konva": "^10.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
